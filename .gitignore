# ---- Gradle / Android ----
.gradle/
build/
app/build/
local.properties
*.iml
.idea/
.cxx/
captures/
*.apk
*.aab
*.ap_
*.dex

# ---- signing (never commit keystores or credentials) ----
*.jks
*.keystore
keystore.properties
release.keystore

# ---- module build intermediates ----
out/
*.zip.mtime
# APK bundled into the flashable zip at build time; never commit the binary
module/app/

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.log
*.swp

# ---- keep the release module zip and OTA manifests tracked ----
!release/*.zip
!release/update.json
!release/app-update.json
!release/changelog.md

# ---- app signing (never commit) ----
app/signing.properties
release-signing/

# ---- bulky / ad-hoc on-device test artifacts (curated copies in docs/screenshots) ----
docs/device/screens/
docs/device/ui-*.xml
docs/device/logcat-*.txt
docs/device/*.sh
# scratch on-device diagnostic dumps at docs/device top level (curated evidence lives under docs/device/raw/)
docs/device/*.txt
scripts/t2.sh
scripts/test_loop*.sh
scripts/test_write.sh
scripts/tz.sh
